# Demo mode: `npm run dev:mock` and `npm run build:mock` load this.
#
# A mode file rather than an inline environment variable, because `VITE_MOCK_API=true vite`
# is a shell-ism that does not work in PowerShell or cmd, and this repository is developed
# on Windows. See src/mocks/ for what it turns on.
VITE_MOCK_API=true
