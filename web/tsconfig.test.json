{
  /*
   * Tests, which are the only code here allowed to touch Node.
   *
   * `tsconfig.app.json` deliberately scopes `types` to `vite/client`: the application runs in
   * a browser and should not be able to reach `process` or `node:fs` by accident. But the
   * guard in `src/lib/noConversions.test.ts` reads the source tree, so the tests need Node's
   * types without lending them to the app.
   */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node", "vitest/globals"]
  },
  // `exclude` is reset: this config extends tsconfig.app.json, which excludes exactly the
  // files this one is here to check.
  "exclude": [],
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test"]
}
